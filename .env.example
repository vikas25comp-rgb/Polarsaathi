# ==============================================================================
# POLAR-SATHI Environment Configuration
# Integrated Polar Expedition Logistics & Emergency Management System (SIH26062)
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (PostgreSQL Database & Authentication)
# Obtain these from your Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
# Public Supabase URL (Used by client and server)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Public Supabase Anonymous Key (Client-safe anon key with Row Level Security)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Optional Server-side Service Role Key (NEVER expose to frontend; used for server admin scripts)
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI CONFIGURATION (Server-side Only)
# Powers NLP assistant, predictive logistics explanations, what-if simulations,
# and AI automated report generation.
# In Google AI Studio, this is injected automatically in runtime environment.
# On Vercel or local, obtain from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# WEATHER SERVICE CONFIGURATION (Server-side Only)
# Mandatory for Polar Weather API Tool. Open-Meteo polar model is used as
# zero-config live default for high-latitude stations; add your OpenWeather key
# here for OpenWeatherMap integration.
# ------------------------------------------------------------------------------
WEATHER_API_KEY=""

# ------------------------------------------------------------------------------
# APPLICATION HOST URL
# The base URL where this applet is hosted (e.g. for self-referential links or webhooks)
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"

